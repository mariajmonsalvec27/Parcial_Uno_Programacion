<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<!-- ventana principal: datos de la academia arriba y una pestaña por cada modulo -->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.poo.parcial_uno_programacion.controller.MainController">
    <top>
        <Label fx:id="lblAcademia" style="-fx-font-weight: bold;">
            <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
        </Label>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Estudiantes"><content><fx:include source="estudiantes-view.fxml"/></content></Tab>
            <Tab text="Docentes"><content><fx:include source="docentes-view.fxml"/></content></Tab>
            <Tab text="Programas"><content><fx:include source="programas-view.fxml"/></content></Tab>
            <Tab text="Servicios"><content><fx:include source="servicios-view.fxml"/></content></Tab>
            <Tab text="Matrículas"><content><fx:include source="matriculas-view.fxml"/></content></Tab>
            <Tab text="Consultas"><content><fx:include source="consultas-view.fxml"/></content></Tab>
        </TabPane>
    </center>
</BorderPane>

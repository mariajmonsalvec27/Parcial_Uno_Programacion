<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.poo.parcial_uno_programacion.controller.EstudianteController">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
    <left>
        <VBox spacing="5" prefWidth="260">
            <padding><Insets right="10"/></padding>
            <Label text="Nombre completo"/>
            <TextField fx:id="txtNombre"/>
            <Label text="Documento de identidad"/>
            <TextField fx:id="txtDocumento"/>
            <Label text="Teléfono"/>
            <TextField fx:id="txtTelefono"/>
            <Label text="Correo electrónico"/>
            <TextField fx:id="txtCorreo"/>
            <Label text="Edad"/>
            <TextField fx:id="txtEdad"/>
            <Label text="Fecha de registro (vacío = hoy)"/>
            <DatePicker fx:id="dpFechaRegistro" maxWidth="Infinity"/>
            <FlowPane hgap="5" vgap="5">
                <Button text="Agregar" onAction="#onAgregar"/>
                <Button text="Actualizar" onAction="#onActualizar"/>
                <Button text="Eliminar" onAction="#onEliminar"/>
                <Button text="Limpiar" onAction="#onLimpiar"/>
            </FlowPane>
        </VBox>
    </left>
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                <TableColumn fx:id="colDocumento" text="Documento" prefWidth="100"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="100"/>
                <TableColumn fx:id="colCorreo" text="Correo" prefWidth="170"/>
                <TableColumn fx:id="colEdad" text="Edad" prefWidth="50"/>
                <TableColumn fx:id="colFecha" text="Registro" prefWidth="90"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
